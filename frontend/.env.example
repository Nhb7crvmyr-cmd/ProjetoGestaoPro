# Copie este arquivo para .env.local e preencha com os valores do "cdk deploy" (stack GestaoPro-Auth).
# Estes IDs NÃO são segredos: todo site que usa Cognito os expõe no navegador.
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
# Endereço da API (saída ApiUrl da stack GestaoPro-Api).
VITE_API_URL=
